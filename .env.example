# Vercel Postgres / Neon Connection String
# Automatically provided when connecting Vercel Postgres in the Vercel Storage tab
POSTGRES_URL=postgres://default:password@ep-cool-pond-123456.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require
DATABASE_URL=postgres://default:password@ep-cool-pond-123456.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require

# Session Secret Key
SESSION_SECRET=change-this-to-a-secure-random-secret-key

# Admin registration code (Optional)
ADMIN_CODE=ADMIN

# Environment
NODE_ENV=development
PORT=3000
