# Supabase Connection String
# Get this from Supabase Dashboard -> Database -> Connection String -> URI
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Session Secret Key
SESSION_SECRET=change-this-to-a-secure-random-secret-key

# Admin registration code (Optional)
ADMIN_CODE=ADMIN

# Environment
NODE_ENV=development
PORT=3000
