# TiDB Cloud MySQL Connection String
# Format: mysql://<username>:<password>@<host>:4000/<database_name>
DATABASE_URL=mysql://root:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/sys

# Session Secret Key
SESSION_SECRET=change-this-to-a-secure-random-secret-key

# Admin registration code (Optional)
ADMIN_CODE=ADMIN

# Environment
NODE_ENV=development
PORT=3000
