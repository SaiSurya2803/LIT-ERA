# TiDB Cloud (MySQL) connection string — the only place database credentials live.
# Format: mysql://<user>:<password>@<host>:4000/sys
# Percent-encode special characters in the password (for example @ -> %40).
DATABASE_URL=mysql://USER:PASSWORD@HOST.tidbcloud.com:4000/sys

# Secret used to sign the login cookie. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: registration code that grants admin rights (the first user is always admin).
ADMIN_CODE=

NODE_ENV=development
PORT=3000
